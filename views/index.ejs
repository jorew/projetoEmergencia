<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link rel="stylesheet" href="/mycss/game.css">
</head>
<body>

  <div id="game">
    <div id="status"></div>

    <!-- TELA DE TÍTULO (Exibida por padrão) -->
    <div id="title-screen" class="screen active">
      <h1 class="game-title">JOGO DE DECISÕES</h1>
      <div class="title-buttons">
        <button class="choice-btn" onclick="startGame()">Novo Jogo</button>
        <button class="choice-btn" onclick="loadGameFromTitle()">Carregar Jogo</button>
      </div>
    </div>

    <!-- TELA DO JOGO (Começa oculta) -->
    <div id="game-screen" class="screen">
      <!-- Adicionar dentro de #game-screen, antes da div #scene -->
<div id="inventory-bar">
  <span>Inventário:</span>
  <div id="inventory-items"></div>
</div>

      <div id="scene">
        <img id="background" src="" alt=""> 
        <img id="character" src="" alt="">
      </div>

      <div id="textbox">
        <div id="speaker"></div>
        <div id="text"></div>
        <div id="choices"></div>
      </div>

      <div id="menu">
        <button class="menu-btn" onclick="saveGame()">Salvar</button>
        <button class="menu-btn" onclick="loadGame()">Carregar</button>
        <button class="menu-btn" onclick="restartGame()">Menu Inicial</button>
      </div>
    </div>
  </div>

  <!-- Dentro do #game-screen (pode ser junto dos botões de Save/Load) -->
<button onclick="openMap()" class="map-btn">🗺️ Mapa</button>

<!-- Modal do Mapa Interativo -->
<div id="map-modal" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="closeMap()">&times;</span>
    <h3>Selecione um Destino</h3>
    
    <div class="map-container">
      <!-- Imagem do Mapa de Fundo -->
      <img src="/images/map.jpg" id="map-image" alt="Mapa da Cidade">
      
      <!-- Pontos de Interesse Clicáveis (Hotspots) -->
      <button class="map-point" style="top: 30%; left: 25%;" onclick="travelTo('quarto')">
        📍 Quarto
      </button>
      
      <button class="map-point" style="top: 55%; left: 60%;" onclick="travelTo('corredor')">
        📍 Corredor
      </button>
      
      <button class="map-point" style="top: 75%; left: 40%;" onclick="travelTo('jardim')">
        📍 Jardim
      </button>
    </div>
  </div>
</div>

  <!-- Scripts do Cliente -->
  <script src="/javascript/story.js"></script>
  <script src="/javascript/engine.js"></script>
</body>
</html>