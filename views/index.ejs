<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apókryphos Town - Visual Novel</title>
  
  <!-- CSS Principal do Jogo -->
  <link rel="stylesheet" href="/mycss/game.css">
  
  <!-- Ícones FontAwesome para a Interface -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- OVERLAY DE TRANSIÇÃO (FADE IN/OUT) -->
  <div id="fade-overlay"></div>

  <!-- TOAST DE NOTIFICAÇÃO/STATUS DE JOGO -->
  <div id="status"></div>

  <!-- ================= SCREEN 1: TELA DE TÍTULO ================= -->
  <div id="title-screen" class="screen active">
    <div class="title-content">
      <h1 class="game-title">Apókryphos Town</h1>
      <p class="game-subtitle">Uma jornada de mistérios e escolhas</p>
      
      <div class="title-menu">
        <button class="btn-title" onclick="startGame()">▶ Novo Jogo</button>
        <button class="btn-title" onclick="openSaveLoadModal('load')">📂 Carregar Jogo</button>
        <button class="btn-title" onclick="openModal('settings-modal')">⚙️ Configurações</button>
      </div>
    </div>
  </div>

  <!-- ================= SCREEN 2: TELA DO JOGO ================= -->
  <div id="game-screen" class="screen">
    
    <!-- BARRA SUPERIOR (HUD) -->
    <div id="top-bar">
      <div class="hud-stats">
        <span id="money-display">💰 $500</span>
      </div>
      <div class="hud-buttons">
        <button onclick="openModal('quests-modal')">📜 Quests</button>
        <button onclick="openModal('inventory-modal')">🎒 Inventário</button>
        <button onclick="openSaveLoadModal('save')">💾 Salvar</button>
        <button onclick="openSaveLoadModal('load')">📂 Carregar</button>
        <button onclick="toggleSidebar()">⚙️ Menu</button>
      </div>
    </div>

    <!-- CAMADA DE FUNDO: IMAGEM ESTÁTICA -->
    <img id="background" src="" alt="Cenário de Fundo" style="display: none;">
    
    <!-- CAMADA DE FUNDO: VÍDEO ANIMADO (LOOP) -->
    <video id="background-video" autoplay loop muted playsinline style="display: none;"></video>

    <!-- CAMADA DOS SPRITES DOS PERSONAGENS -->
    <div id="characters-layer"></div>

    <!-- CAMADA DE HOTSPOTS INTERATIVOS (CENAS DO TIPO EXPLORE) -->
    <div id="hotspots-layer"></div>

    <!-- MINIGAME CONTAINER (EX: QUEBRA-CABEÇAS/SENHAS) -->
    <div id="minigame-container" style="display: none;"></div>

    <!-- CAIXA DE DIÁLOGO E OPÇÕES NARRATIVAS -->
    <div id="textbox" style="display: none;">
      <div id="speaker"></div>
      <div id="text"></div>
      <div id="choices"></div>
    </div>

  </div>

  <!-- ================= MENU LATERAL (SIDEBAR) ================= -->
  <div id="sidebar">
    <div class="sidebar-header">
      <h3>Opções do Jogo</h3>
      <button class="close-btn" onclick="toggleSidebar()">✕</button>
    </div>
    <div class="sidebar-body">
      <button id="btn-toggle-bgm" class="btn-sidebar" onclick="toggleBGM()">🎵 Música: LIGADA</button>
      <button id="btn-toggle-voice" class="btn-sidebar" onclick="toggleVoice()">🎙️ Vozes: LIGADAS</button>
      <button class="btn-sidebar" onclick="restartGame()">🏠 Voltar ao Menu Principal</button>
    </div>
  </div>

  <!-- ================= MODAL: INVENTÁRIO ================= -->
  <div id="inventory-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>🎒 Inventário</h2>
        <button class="close-btn" onclick="closeModal('inventory-modal')">✕</button>
      </div>
      <div id="inventory-items-container" class="modal-body">
        <!-- Itens injetados via engine.js -->
      </div>
    </div>
  </div>

  <!-- ================= MODAL: QUESTS (DIÁRIO) ================= -->
  <div id="quests-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>📜 Diário de Objetivos</h2>
        <button class="close-btn" onclick="closeModal('quests-modal')">✕</button>
      </div>
      <div id="quests-container" class="modal-body">
        <!-- Missões injetadas via engine.js -->
      </div>
    </div>
  </div>

  <!-- ================= MODAL: SAVE / LOAD SLOTS ================= -->
  <div id="saveload-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="saveload-title">Salvar Jogo</h2>
        <button class="close-btn" onclick="closeSaveModal()">✕</button>
      </div>
      <div class="modal-body">
        <div id="slots-grid">
          <!-- Slots de Save injetados via engine.js -->
        </div>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: LAPTOP DO PROTAGONISTA ================= -->
  <div id="laptop-modal" class="modal">
    <div class="laptop-frame">
      <!-- DETALHE DO HARDWARE: CÂMERA DO NOTBOOK -->
      <div class="laptop-camera"></div>

      <!-- TELA DO SISTEMA OPERACIONAL SIMULADO -->
      <div id="os-desktop" class="os-desktop">
        
        <!-- ÍCONES DA ÁREA DE TRABALHO -->
        <div class="desktop-icons">
          <div class="icon" onclick="openLaptopApp('buyline')">
            <div class="icon-box purple"><i class="fas fa-shopping-cart"></i></div>
            <span>Buyline</span>
          </div>

          <div class="icon" onclick="openLaptopApp('settings')">
            <div class="icon-box gray"><i class="fas fa-sliders-h"></i></div>
            <span>Aparência</span>
          </div>
        </div>

        <!-- JANELA 1: PERSONALIZAÇÃO DE APARÊNCIA / WALLPAPERS -->
        <div id="app-settings" class="window hidden">
          <div class="window-header">
            <span>⚙️ Personalizar Wallpaper</span>
            <button class="win-btn-close" onclick="closeLaptopApp('settings')">✕</button>
          </div>
          <div class="window-body">
            <p>Escolha o papel de parede da sua tela:</p>
            <div class="wallpaper-grid">
              <div class="wallpaper-card" onclick="changeWallpaper('linear-gradient(135deg, #1e1e2f, #0f3460)')">
                <div class="wp-preview" style="background: linear-gradient(135deg, #1e1e2f, #0f3460);"></div>
                <span>Escuro Padrão</span>
              </div>
              <div class="wallpaper-card" onclick="changeWallpaper('linear-gradient(135deg, #ff7e5f, #feb47b)')">
                <div class="wp-preview" style="background: linear-gradient(135deg, #ff7e5f, #feb47b);"></div>
                <span>Pôr do Sol</span>
              </div>
              <div class="wallpaper-card" onclick="changeWallpaper('linear-gradient(135deg, #2b5876, #4e4376)')">
                <div class="wp-preview" style="background: linear-gradient(135deg, #2b5876, #4e4376);"></div>
                <span>Oceano</span>
              </div>
              <div class="wallpaper-card" onclick="changeWallpaper('linear-gradient(135deg, #11998e, #38ef7d)')">
                <div class="wp-preview" style="background: linear-gradient(135deg, #11998e, #38ef7d);"></div>
                <span>Aurora</span>
              </div>
            </div>
          </div>
        </div>

        <!-- JANELA 2: APLICATIVO BUYLINE (LOJA DE PASSAGENS ONLINE) -->
        <div id="app-buyline" class="window hidden">
          <div class="window-header purple-header">
            <span>🛍️ Buyline - Passagens e Reservas</span>
            <button class="win-btn-close" onclick="closeLaptopApp('buyline')">✕</button>
          </div>
          <div class="window-body">
            <div class="ticket-card">
              <h3>🚌 Expresso Apókryphos Town</h3>
              <p class="ticket-info">Saída: Terminal Central</p>
              <p class="ticket-info">Assento: B12 (Janela)</p>
              <div class="ticket-price">$150,00</div>
              
              <button id="buyline-btn" class="btn-buy" onclick="buyTicketViaBuyline()">
                Finalizar Compra ($150)
              </button>
            </div>
          </div>
        </div>

        <!-- BARRA DE TAREFAS INFERIOR (TASKBAR) -->
        <div class="taskbar">
          <button class="start-menu-btn" onclick="closeModal('laptop-modal')">🚪 Sair do PC</button>
          <div class="system-tray">
            <span><i class="fas fa-volume-up"></i></span>
            <span><i class="fas fa-wifi"></i></span>
            <span><i class="fas fa-battery-full"></i> 100%</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- CARREGAMENTO DOS SCRIPTS DO JOGO -->
  <script src="/javascript/story.js"></script>
  <script src="/javascript/engine.js"></script>

</body>
</html>
